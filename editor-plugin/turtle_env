#
# turtle_env --setup FILE ARGS...
#
# Sources FILE and hands ARGS to the ros2_env adapter of hsm_generator (the hsm-ros2 plugin)
# found in that environment.

EXIT_USAGE=5

fail() {
    echo "turtle_env: $1" >&2
    exit $EXIT_USAGE
}

[ "$1" = --setup ] && [ $# -ge 2 ] || fail "usage: turtle_env --setup FILE ARGS..."
SETUP=$2
shift 2
# the setup scripts read unset variables, so they are sourced without set -u
if [ -n "$SETUP" ]; then
    [ -f "$SETUP" ] || fail "the ROS 2 setup $SETUP is not found; set it in the plugin settings"
    . "$SETUP" || fail "sourcing $SETUP failed"
fi
IFS=: read -r -a PREFIXES <<< "${AMENT_PREFIX_PATH:-}"
for PREFIX in "${PREFIXES[@]}"; do
    ADAPTER=$PREFIX/share/hsm_generator/editor-plugin/ros2_env
    if [ -f "$ADAPTER" ]; then
        exec bash "$ADAPTER" --setup "" "$@"
    fi
done
fail "the package hsm_generator is not found; check the ROS 2 setup"
